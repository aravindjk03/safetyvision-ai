# SafetyVision AI — Environment Variables Configuration Template
# Copy this file to .env and adjust variables for your target deployment environment.

# Application Environment
SAFETYVISION_ENV=development
SAFETYVISION_DEBUG=false
SAFETYVISION_SECRET_KEY=change-in-production-to-a-secure-random-key

# Storage Paths (Overrides defaults in config/config.yaml if set)
# SAFETYVISION_DB_PATH=data/safetyvision.db
# SAFETYVISION_EVIDENCE_DIR=evidence
# SAFETYVISION_REPORTS_DIR=reports

# Model Execution
SAFETYVISION_MODEL_PATH=models/safetyvision_yolo26n.pt
SAFETYVISION_DEVICE=auto

# API Server
SAFETYVISION_API_HOST=0.0.0.0
SAFETYVISION_API_PORT=8000
SAFETYVISION_API_KEY=

# Industrial PLC / MQTT Integration (Optional)
PLC_ENABLED=false
PLC_IP_ADDRESS=192.168.1.100
PLC_PORT=502
PLC_RACK=0
PLC_SLOT=1
